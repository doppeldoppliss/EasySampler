{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "maddaw-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    },
    {
      "name": "maddaw-lan",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:lan",
        "--",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180,
      "url": "https://localhost:5180"
    },
    {
      "name": "maddaw-fresh",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5182",
        "--strictPort"
      ],
      "port": 5182
    }
  ]
}
